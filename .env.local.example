# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# Leave these unset to run the app in local demo mode — it works out of the
# box against src/data/mockStore.ts (localStorage), no Supabase needed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
